generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Perfil {
  ALUNO
  PROFESSOR
  ADMIN
}

model User {
  id        Int         @id @default(autoincrement())
  nome      String
  email     String      @unique
  senha     String
  perfil    Perfil      @default(ALUNO)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  progresso Progresso[]
}

model Conteudo {
  id          Int          @id @default(autoincrement())
  titulo      String
  descricao   String
  disciplina  String
  nivel       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  atividades Atividade[]
}

model Atividade {
  id          Int         @id @default(autoincrement())
  conteudoId  Int
  pergunta    String
  resposta    String
  dificuldade String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  conteudo  Conteudo    @relation(fields: [conteudoId], references: [id], onDelete: Cascade)
  progresso Progresso[]
}

model Progresso {
  id          Int        @id @default(autoincrement())
  userId      Int
  atividadeId Int
  resposta    String
  acertou     Boolean
  data        DateTime   @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  atividade Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
}